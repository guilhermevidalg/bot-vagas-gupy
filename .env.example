# Copie este arquivo para .env e preencha com seus dados (o .env NÃO vai para o Git)

# Token do bot: crie o bot conversando com o @BotFather no Telegram (comando /newbot)
TELEGRAM_TOKEN=
# Seu chat_id: mande uma mensagem qualquer para o bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates — o número fica em "chat" -> "id"
TELEGRAM_CHAT_ID=
